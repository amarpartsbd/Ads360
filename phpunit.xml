<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>

        <!--
            Tests run against PostgreSQL, not SQLite. The schema relies on
            jsonb columns and partial unique indexes, and the isolation tests
            are only meaningful against the engine production uses.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="ads360_testing"/>
        <env name="DB_USERNAME" value="ads360"/>
        <env name="DB_PASSWORD" value="ads360"/>
        <env name="DB_URL" value=""/>

        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>

        <!-- Sessions are exercised through the database, as in production. -->
        <env name="SESSION_DRIVER" value="database"/>
        <env name="SESSION_ENCRYPT" value="false"/>

        <!--
            Argon2id is deliberately expensive. The lowest parameters the
            algorithm accepts keep the suite fast; production values live in
            config/hashing.php.
        -->
        <env name="ARGON_MEMORY" value="8"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="BCRYPT_ROUNDS" value="4"/>

        <env name="ADMIN_REQUIRE_TWO_FACTOR" value="false"/>
        <env name="CONTENT_SECURITY_POLICY" value="false"/>
        <env name="ADVERTISING_DRIVER" value="mock"/>

        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
