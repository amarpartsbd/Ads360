### Production environment for a single node.
###
### provision.sh renders this to /var/www/ads360/.env, substituting the domain
### and the database credentials it generated. Everything left blank below is a
### credential that has to be obtained from a provider and pasted in by hand —
### none of them belong in the repository (Rule 6, Rule 13).
###
### After editing: `php artisan config:cache` — a cached config does not re-read
### this file.

APP_NAME=Ads360
APP_ENV=production
APP_KEY=
# Never true here. The exception page carries file paths, environment values
# and a stack trace, and it is served to whoever triggered the error.
APP_DEBUG=false
APP_URL=https://__APP_DOMAIN__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PLATFORM_NAME="Ads360"
PLATFORM_SUPPORT_EMAIL=support@banik360.com
PLATFORM_DEFAULT_CURRENCY=BDT
PLATFORM_DEFAULT_TIMEZONE=Asia/Dhaka
PLATFORM_DEFAULT_COUNTRY=BD

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` would write request payloads to disk on a platform that handles KYC
# documents and payment references.
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=__DB_DATABASE__
DB_USERNAME=__DB_USERNAME__
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# The three that make the session cookie safe to hand a browser over TLS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ads360

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

### Mail. `log` writes messages to storage/logs instead of sending them, which
### means invitations, password resets and verification links go nowhere.
### Set a real transport before inviting anybody.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@banik360.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

### Object storage. Creatives and KYC documents are on the local private disk
### until these are set, which is fine on one node and is not a backup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

### Security (spec §9, §53)
ADMIN_REQUIRE_TWO_FACTOR=true
ADMIN_SESSION_LIFETIME=30
# Comma-separated CIDRs. Empty means the admin area is reachable from anywhere,
# which is worth revisiting once the office addresses are known.
ADMIN_IP_ALLOWLIST=
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
FORCE_HTTPS=true
CONTENT_SECURITY_POLICY=true

### Feature flags (spec §84). Everything past the core platform stays dark
### until the work behind it has been through its own shakedown — see
### docs/DEPLOYMENT.md before turning any of these on.
FEATURE_GOOGLE_ADS=false
FEATURE_AGENCY_MODULE=false
FEATURE_AI_ASSISTANT=false
FEATURE_WHITE_LABEL=false
FEATURE_AUTOMATED_RULES=false
FEATURE_ADVANCED_REPORTING=false

# The only adapter that exists is a mock, and it refuses to instantiate in
# production. Leave this as `none`.
ASSISTANT_DRIVER=none

### Advertising providers.
###
### `mock` refuses to run in production, so this node publishes nothing until
### it is `live` AND the credentials below are filled in. That is the intended
### state for a first deployment: the platform, the wallets, the campaign
### builder and the approval queue all work, and a campaign approved for
### publishing waits rather than being sent somewhere unverified.
ADVERTISING_DRIVER=mock

### Meta Marketing API (spec §26). Required when ADVERTISING_DRIVER=live.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/app/assets/callback/meta"
META_API_VERSION=v21.0
META_BUSINESS_ID=
# A system user token from the platform's Business Manager — never a person's.
META_SYSTEM_USER_TOKEN=
# Any long random string; compared in constant time during the webhook handshake.
META_WEBHOOK_VERIFY_TOKEN=
META_REQUEST_TIMEOUT=30
META_CONNECT_TIMEOUT=10
META_MAX_ATTEMPTS=3
META_RETRY_DELAY_MS=500

### Google Ads API (spec §26). Required when ADVERTISING_DRIVER=live and
### FEATURE_GOOGLE_ADS=true.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI="${APP_URL}/app/assets/callback/google"
GOOGLE_ADS_API_VERSION=v21
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_REQUEST_TIMEOUT=60
GOOGLE_ADS_CONNECT_TIMEOUT=10
GOOGLE_ADS_MAX_ATTEMPTS=3
GOOGLE_ADS_RETRY_DELAY_MS=500

### Analytics and reconciliation (spec §38, §78)
RECONCILIATION_TOLERANCE_MINOR=10000
RECONCILIATION_TOLERANCE_PERCENT=2

### Report exports (spec §39)
REPORT_EXPORT_LIFETIME_DAYS=7
REPORT_MAX_EXPORT_DAYS=400
REPORTS_DISK_DRIVER=local
AWS_REPORTS_BUCKET=

### Managed ad account health thresholds (spec §20)
AD_ACCOUNT_UTILISATION_WARNING=80
AD_ACCOUNT_UTILISATION_CRITICAL=95
AD_ACCOUNT_FAILURES_DEGRADED=2
AD_ACCOUNT_FAILURES_CRITICAL=5
AD_ACCOUNT_STALE_AFTER_HOURS=6

### Maker-checker thresholds (spec §25), in integer minor units
FINANCE_MAKER_CHECKER_CAMPAIGN_MINOR=10000000

### Creatives live on a private disk, like KYC documents (spec §23)
CREATIVES_DISK_DRIVER=local
AWS_CREATIVES_BUCKET=
