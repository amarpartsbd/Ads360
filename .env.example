APP_NAME=Ads360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Platform defaults (spec §83). Never hard-code these in application code.
PLATFORM_NAME="Ads360"
PLATFORM_SUPPORT_EMAIL=support@ads360.test
PLATFORM_DEFAULT_CURRENCY=BDT
PLATFORM_DEFAULT_TIMEZONE=Asia/Dhaka

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ads360
DB_USERNAME=ads360
DB_PASSWORD=ads360

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ads360

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ads360.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3 compatible object storage (AWS S3 or Cloudflare R2) — spec §55.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Security (spec §9, §53)
ADMIN_REQUIRE_TWO_FACTOR=true
ADMIN_SESSION_LIFETIME=30
ADMIN_IP_ALLOWLIST=
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
FORCE_HTTPS=false

# Feature flags (spec §84)
FEATURE_GOOGLE_ADS=false
FEATURE_AGENCY_MODULE=false
FEATURE_AI_ASSISTANT=false
FEATURE_WHITE_LABEL=false
FEATURE_AUTOMATED_RULES=false
FEATURE_ADVANCED_REPORTING=false

# Advertising providers — mock adapters until live credentials are approved (spec §95)
# `mock` for development and tests; `live` in production once provider access
# is approved. A mock refuses to instantiate in production, and a provider with
# no live adapter is refused rather than falling back to its mock.
ADVERTISING_DRIVER=mock

# Meta Marketing API (spec §26). Required when ADVERTISING_DRIVER=live.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/app/assets/callback/meta"
META_API_VERSION=v21.0
META_BUSINESS_ID=

# Echoed back during Meta's webhook subscription handshake (spec §52).
# Any long random string; it is compared in constant time.
META_WEBHOOK_VERIFY_TOKEN=

META_REQUEST_TIMEOUT=30
META_CONNECT_TIMEOUT=10
META_MAX_ATTEMPTS=3
META_RETRY_DELAY_MS=500

# Managed ad account health thresholds (spec §20).
# Utilisation is measured against each account's own daily limit.
AD_ACCOUNT_UTILISATION_WARNING=80
AD_ACCOUNT_UTILISATION_CRITICAL=95
# Consecutive failed provider checks before an account is treated as ill.
AD_ACCOUNT_FAILURES_DEGRADED=2
AD_ACCOUNT_FAILURES_CRITICAL=5
# How long an account may go unchecked before its health is treated as unknown.
AD_ACCOUNT_STALE_AFTER_HOURS=6

# Campaign budgets at or above this need a second approver (spec §25).
FINANCE_MAKER_CHECKER_CAMPAIGN_MINOR=10000000

# Uploaded creatives live on a private disk, like KYC documents (spec §23).
CREATIVES_DISK_DRIVER=local
AWS_CREATIVES_BUCKET=
