includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes
        - tests

    # Level 6 requires the type information this codebase already declares, and
    # is raised as the platform grows. Raising it is a deliberate change, not a
    # background one.
    level: 6

    checkModelProperties: true
    checkOctaneCompatibility: false

    # Every model in this codebase declares its casts in the `casts()` method
    # (Laravel 11+ style) rather than the legacy `$casts` array. Without this,
    # Larastan sees none of them: a date column reads as a string, an enum
    # column as a string, and a jsonb column as a string, which turns most of
    # the model layer into noise. Reading the method is what makes the analysis
    # match what the application actually does at runtime.
    parseModelCastsMethod: true

    excludePaths:
        - vendor
        - bootstrap/cache
        - storage
